# Configuration de l'environnement Tabiria-Nvua Engine (nvua-engine)
PROJECT_NAME="Tabiria-Nvua Engine - geocongoai AI Weather & Climate Intelligence"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Sécurité & Clés d'API
SECRET_KEY="tabiria_nvua_engine_geocongoai_super_secret_key_2026"
API_KEY_HEADER="X-API-Key"
STATION_SECRET_KEY="vula_station_token_xxx"
VALID_API_KEYS=["geocongoai_key_master_2026","vula_station_token_xxx","demo_key"]

# Base de données
# SQLite (développement local)
DATABASE_URL="sqlite+aiosqlite:///./tabiria_nvua_engine.db"
# PostgreSQL / TimescaleDB (production)
# DATABASE_URL="postgresql+asyncpg://nvua_user:nvua_password@localhost:5432/nvua_db"

# Paramètres GPU & Compute
USE_GPU_IF_AVAILABLE=true
DEFAULT_CUDA_DEVICE=0
MODEL_CACHE_DIR="./cache/earth2studio"

# Modèles Earth2Studio & DataSources
DEFAULT_FORECAST_MODEL="FourCastNet"
SUPPORTED_MODELS=["FourCastNet","GraphCast","Pangu-Weather","DLWP"]
ERA5_DATASET_BUCKET="s3://era5-pds/zarr/"
CDS_API_KEY=""
CDS_API_URL=""

# Seuils d'alerte aux risques météorologiques extrêmes
ALERT_PRECIP_INTENSITY_MM_H=10.0
ALERT_PRECIP_24H_MM=50.0
ALERT_WIND_GUST_MS=20.0
ALERT_PRESSURE_DROP_HPA_3H=6.0
